{
  "name": "easy-npm-publish",
  "version": "0.0.0",
  "description": "Use Conventional Commits to automatically update the package version, update the git tags and publish the package.",
  "module": "dist/index.js",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:w": "npm run build -- --watch",
    "build": "npm run clean && ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "clean": "rimraf dist",
    "format:ci": "prettier --check '**.{mjs,cjs,js,json,md,ts,yaml,yml}'",
    "format": "prettier --write .",
    "lint:ci": "eslint '**/*.{mjs,cjs,js,ts}'",
    "lint:inspect": "npx @eslint/config-inspector",
    "lint:nc": "eslint '**/*.{mjs,cjs,js,ts}' --report-unused-disable-directives --fix",
    "lint:renovate": "npx --yes --package renovate -- renovate-config-validator --strict",
    "lint": "eslint '**/*.{mjs,cjs,js,ts}' --cache --report-unused-disable-directives --fix",
    "pre-commit": "lint-staged --config lint-staged.config.js",
    "prepare": "husky || true",
    "test:ci": "vitest run --config vite.config.ci.ts --coverage",
    "test:ui": "vitest --ui",
    "test:w": "vitest",
    "test": "vitest run --coverage",
    "type": "tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/glitch452/easy-npm-publish.git"
  },
  "keywords": [
    "npm",
    "package",
    "publish",
    "conventional",
    "commit",
    "auto",
    "version",
    "github",
    "action"
  ],
  "author": "David Dearden",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/glitch452/easy-npm-publish/issues"
  },
  "homepage": "https://github.com/glitch452/easy-npm-publish#readme",
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@actions/github": "9.1.1",
    "chardet": "2.2.0",
    "semver": "7.8.5",
    "simple-git": "3.36.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "24.13.3",
    "@vercel/ncc": "0.44.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-spartan": "7.1.0",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "memfs": "4.64.0",
    "msw": "2.15.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
